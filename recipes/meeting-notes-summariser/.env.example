# Meeting Notes Summariser — Environment Configuration
# Copy this file to .env and fill in your values.

# NVIDIA NIM API key (free at https://build.nvidia.com)
LLM_API_KEY=nvapi-YOUR_KEY_HERE

# Optional: Change default model (default is meta/llama-3.1-8b-instruct)
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional: Base URL (default is https://integrate.api.nvidia.com/v1)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
